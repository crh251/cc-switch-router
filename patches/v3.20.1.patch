+/// 从上游错误响应体中提取可读的报错原因
+///
+/// 优先取常见错误信封的 message 字段（Anthropic/OpenAI/Gemini 的
+/// `error.message`、顶层 `message`、MiniMax 的 `base_resp.status_msg`），
+/// JSON 解析失败时回退原文（截断）。返回 None 表示响应体里没有可读原因。
+pub fn extract_upstream_error_reason(body: Option<&str>) -> Option<String> {
+    const MAX_REASON_CHARS: usize = 500;
+
+    fn compact(reason: String) -> Option<String> {
+        let reason = reason.split_whitespace().collect::<Vec<_>>().join(" ");
+        if reason.is_empty() {
+            return None;
+        }
+        if reason.chars().count() > MAX_REASON_CHARS {
+            let truncated: String = reason.chars().take(MAX_REASON_CHARS).collect();
+            Some(format!("{truncated}…"))
+        } else {
+            Some(reason)
+        }
+    }
+
+    let body = body?.trim();
+    if body.is_empty() {
+        return None;
+    }
+
+    if let Ok(value) = serde_json::from_str::<serde_json::Value>(body) {
+        let from_value = |v: &serde_json::Value| -> Option<String> {
+            v.as_str()
+                .map(ToString::to_string)
+                .filter(|s| !s.trim().is_empty())
+        };
+        let reason = value
+            .get("error")
+            .and_then(|err| {
+                // message 缺失时回退整个 error 值（部分网关是 "error": "字符串" 形式）
+                err.get("message")
+                    .and_then(from_value)
+                    .or_else(|| from_value(err))
+            })
+            .or_else(|| from_value(value.get("message")?))
+            .or_else(|| {
+                value
+                    .get("base_resp")?
+                    .get("status_msg")
+                    .and_then(from_value)
+            });
+        // JSON 信封里没取到 message 时不再回退整段 JSON（对用户是噪音）
+        return reason.and_then(compact);
+    }
+
+    compact(body.to_string())
+}
+
+/// 请求日志专用的简明错误信息
+///
+/// 上游错误时从响应体提取可读原因（避免整段原始报文进库），其余错误
+/// 沿用 `get_error_message`。客户端可见的错误响应仍走 `get_error_message`，
+/// 行为不变。
+pub fn get_log_error_message(error: &ProxyError) -> String {
+    match error {
+        ProxyError::UpstreamError { status, body } => {
+            match extract_upstream_error_reason(body.as_deref()) {
+                Some(reason) => format!("上游错误 ({status}): {reason}"),
+                None => format!("上游错误 ({status})"),
+            }
+        }
+        other => get_error_message(other),
+    }
+}
