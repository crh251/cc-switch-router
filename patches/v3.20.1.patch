diff --git a/src-tauri/resources/ccs b/src-tauri/resources/ccs
new file mode 100755
index 0000000..23df4dd
--- /dev/null
+++ b/src-tauri/resources/ccs
@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+# ccs — Claude Code 终端级供应商切换
+# （依赖补丁版 CC Switch Router 运行中，且已开启路由接管）
+#
+#   ccs                    官方直连（api.anthropic.com，不经本地路由）
+#   ccs <供应商名> [args…]  经本地路由（x-ccs-provider 请求头）固定到该供应商，
+#                          args 原样透传给 claude
+#
+# 示例:
+#   ccs                    # 官方
+#   ccs kimi               # 走本地路由 → Kimi
+#   ccs glm-router         # 走本地路由 → GLM 标准端点（自动协议转换）
+#   ccs kimi -c            # 走 Kimi 并继续上次会话
+#
+# 供应商名 = cc-switch 界面里的名字，不区分大小写、支持部分匹配。
+set -euo pipefail
+# 防 bash 3.2 在非 UTF-8 locale 下把紧邻变量的多字节字符解析进变量名
+export LC_ALL=en_US.UTF-8
+
+case "${1:-}" in
+  "")
+    # 官方直连：覆盖 base、清空 token（claude.ai 登录生效）
+    exec claude --settings '{"env":{"ANTHROPIC_BASE_URL":"https://api.anthropic.com","ANTHROPIC_AUTH_TOKEN":""}}'
+    ;;
+  -h|--help|help)
+    grep '^# ' "$0" | sed 's/^# \{0,1\}//'
+    exit 0 ;;
+esac
+
+NAME="$1"; shift
+case "$NAME" in
+  *'"'|*'\'*)
+    echo "ccs: 供应商名含非法字符（引号/反斜杠）" >&2
+    exit 1 ;;
+esac
+
+# 预检本地路由端口
+if ! nc -z 127.0.0.1 15721 2>/dev/null; then
+  echo "⚠️ cc-switch 本地路由（127.0.0.1:15721）未运行——请启动 CC Switch Router 并开启路由接管" >&2
+  exit 1
+fi
+
+# 供应商存在性校验（只读查询；sqlite3 缺失则跳过校验）
+if command -v sqlite3 >/dev/null 2>&1 && [ -f "$HOME/.cc-switch/cc-switch.db" ]; then
+  SAFE=${NAME//\'/}
+  HIT=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
+    "SELECT COUNT(*) FROM providers WHERE app_type='claude' AND name LIKE '%'||'$SAFE'||'%'" 2>/dev/null || echo 1)
+  if [ "${HIT:-0}" = "0" ]; then
+    echo "ccs: cc-switch 里没有匹配 ${NAME} 的供应商（需与 cc-switch 中名字一致）" >&2
+    exit 1
+  fi
+fi
+
+# 经本地路由：注入 x-ccs-provider 请求头（其余配置沿用全局接管）
+exec claude --settings "{\"env\":{\"ANTHROPIC_CUSTOM_HEADERS\":\"x-ccs-provider: ${NAME}\"}}" "$@"
diff --git a/src-tauri/src/ccs_router.rs b/src-tauri/src/ccs_router.rs
