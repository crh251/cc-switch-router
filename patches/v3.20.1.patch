+            ),
+        )
+        .unwrap();
+
+        regenerate_claude_settings_files(&db);
+
+        let file = home
+            .claude_home_dir()
+            .join("senseaudio")
+            .join("settings.json");
+        let content = std::fs::read_to_string(&file).expect("senseaudio settings should exist");
+        assert!(content.contains("x-ccs-provider: senseaudio"));
+        assert!(content.contains("ANTHROPIC_DEFAULT_OPUS_MODEL_NAME\": \"deepseek-v4-pro"));
+        // 未映射的档位回落官方别名
+        assert!(content.contains("ANTHROPIC_DEFAULT_SONNET_MODEL_NAME\": \"claude-sonnet-4-6"));
+        // 用户级非 env 键保留
+        assert!(content.contains("statusLine"));
+        // env 整体接管：用户级遗留 env 键清除
+        assert!(!content.contains("STALE_KEY"));
+        // 官方供应商不生成
+        assert!(!home.claude_home_dir().join("Claude Official").exists());
+        assert!(home.claude_home_dir().join("sensenova").exists());
+    }
+
+    #[test]
+    #[serial]
+    fn test_regenerate_is_idempotent_and_cleans_stale_files() {
+        let home = TempHome::new();
+        let db = Arc::new(Database::memory().unwrap());
+        db.save_provider(
+            "claude",
+            &make_provider("a", "senseaudio", "deepseek-v4-pro"),
+        )
+        .unwrap();
+        regenerate_claude_settings_files(&db);
+        let file = home
+            .claude_home_dir()
+            .join("senseaudio")
+            .join("settings.json");
+        let first = std::fs::read_to_string(&file).unwrap();
+
+        // 内容未变：幂等跳过（mtime 不变）
+        let mtime_1 = std::fs::metadata(&file).unwrap().modified().unwrap();
+        regenerate_claude_settings_files(&db);
+        let mtime_2 = std::fs::metadata(&file).unwrap().modified().unwrap();
+        assert_eq!(mtime_1, mtime_2);
+        assert_eq!(first, std::fs::read_to_string(&file).unwrap());
+
+        // 供应商被删除：遗留配置目录整体清理
+        db.delete_provider("claude", "a").unwrap();
+        regenerate_claude_settings_files(&db);
+        assert!(!file.exists());
+    }
