+    #[tokio::test]
+    #[serial]
+    async fn test_select_provider_by_override() {
+        let _home = TempHome::new();
+        let db = Arc::new(Database::memory().unwrap());
+
+        let provider_a = Provider::with_id("a".to_string(), "Kimi".to_string(), json!({}), None);
+        let provider_b = Provider::with_id(
+            "b".to_string(),
+            "Zhipu GLM - router".to_string(),
+            json!({}),
+            None,
+        );
+
+        db.save_provider("claude", &provider_a).unwrap();
+        db.save_provider("claude", &provider_b).unwrap();
+        db.set_current_provider("claude", "a").unwrap();
+
+        let router = ProviderRouter::new(db);
+
+        // 名字精确命中
+        let hit = router
+            .select_provider_by_override("claude", "Kimi")
+            .await
+            .unwrap()
+            .expect("应命中 Kimi");
+        assert_eq!(hit.id, "a");
+
+        // 名字忽略大小写 + 含空格
+        let hit = router
+            .select_provider_by_override("claude", "zhipu glm - ROUTER")
+            .await
+            .unwrap()
+            .expect("应命中 GLM");
+        assert_eq!(hit.id, "b");
+
+        // 按 id 命中
+        let hit = router
+            .select_provider_by_override("claude", "b")
+            .await
+            .unwrap()
+            .expect("应按 id 命中");
+        assert_eq!(hit.name, "Zhipu GLM - router");
+
+        // 未命中 → None
+        assert!(
+            router
+                .select_provider_by_override("claude", "no-such-provider")
+                .await
+                .unwrap()
+                .is_none()
+        );
+    }
