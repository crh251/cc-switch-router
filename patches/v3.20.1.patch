+//! 把打包资源中的 ccs 脚本以软链接方式安装到 PATH 目录
+//!
+//! 每次 app 启动执行：确保资源文件可执行，并在第一个「存在于 PATH 且可写」的
+//! 候选目录里建立指向它的软链接。链接指向 app 内资源，app 升级后自动跟随；
+//! app 被移动后链接会失效，但下次启动会自动重建。所有失败只记日志，不阻断启动。
+
+use std::path::{Path, PathBuf};
+use tauri::Manager;
+
+/// 候选安装目录（按优先级）；以 . 开头的相对路径基于用户 HOME
+const CANDIDATE_DIRS: [&str; 3] = ["/opt/homebrew/bin", "/usr/local/bin", ".local/bin"];
+
+pub fn install_on_startup(app: &tauri::AppHandle) {
+    if !cfg!(unix) {
+        log::warn!("[ccs] 非 unix 平台，跳过 ccs 安装");
+        return;
+    }
+    let Ok(resource) = app
+        .path()
+        .resolve("resources/ccs", tauri::path::BaseDirectory::Resource)
+    else {
+        log::warn!("[ccs] 无法解析打包资源 resources/ccs");
+        return;
+    };
+
+    // 打包过程可能重置权限，确保脚本可执行
+    if let Ok(meta) = std::fs::metadata(&resource) {
+        let mut perms = meta.permissions();
+        if perms.mode() & 0o111 != 0o111 {
+            perms.set_mode(0o755);
+            if let Err(e) = std::fs::set_permissions(&resource, perms) {
+                log::warn!("[ccs] 无法为资源文件添加执行权限: {e}");
+                return;
+            }
+        }
+    }
+    let script = match std::fs::read_to_string(&resource) {
+        Ok(s) if s.starts_with("#!") => s,
+        _ => {
+            log::warn!("[ccs] 打包的 ccs 脚本内容异常，跳过安装");
+            return;
+        }
+    };
+
+    let path_env = std::env::var("PATH").unwrap_or_default();
+    for dir in CANDIDATE_DIRS {
+        let dir: PathBuf = if let Some(stripped) = dir.strip_prefix('.') {
+            let home = std::env::var("HOME").unwrap_or_default();
+            if home.is_empty() {
+                continue;
+            }
+            Path::new(&home).join(stripped)
+        } else {
+            PathBuf::from(dir)
+        };
+
+        // 只安装到「存在 && 已在 PATH」的目录，避免装到用户找不到的地方
+        if !dir.is_dir() || !path_env.split(':').any(|p| Path::new(p) == dir) {
+            continue;
+        }
+
+        let link = dir.join("ccs");
+        if let Ok(current) = std::fs::read_link(&link) {
+            if current == resource {
+                log::info!("[ccs] 软链接已是最新: {}", link.display());
+                return;
+            }
+        }
+        // 已存在同名文件：仅当它是软链接、或内容是脚本文本时才覆盖，避免误伤无关文件
+        if link.exists() {
+            let is_symlink = std::fs::symlink_metadata(&link)
+                .map(|m| m.file_type().is_symlink())
+                .unwrap_or(false);
+            let looks_like_script = std::fs::read_to_string(&link)
+                .map(|content| content.starts_with("#!"))
+                .unwrap_or(false);
+            if !is_symlink && !looks_like_script {
+                log::warn!("[ccs] {} 已存在且不是脚本，跳过安装", link.display());
+                return;
+            }
+            let _ = std::fs::remove_file(&link);
+        }
+
+        match std::os::unix::fs::symlink(&resource, &link) {
+            Ok(()) => {
+                log::info!(
+                    "[ccs] ccs 已安装: {} -> {}",
+                    link.display(),
+                    resource.display()
+                );
+                return;
+            }
+            Err(e) => log::warn!("[ccs] 创建软链接失败 {}: {e}", link.display()),
+        }
+    }
+    log::warn!("[ccs] 没有「在 PATH 中且可写」的候选目录，请手动安装 ccs 脚本");
+}
