+    }
+
+    #[test]
+    #[serial]
+    fn test_regenerate_creates_files_with_mapping() {
+        let home = TempHome::new();
+        // 用户真实 settings 作为合并底：非 env 键保留，env 整体被接管覆盖
+        let user_claude_dir = home.dir.path().join(".claude");
+        std::fs::create_dir_all(&user_claude_dir).unwrap();
+        std::fs::write(
+            user_claude_dir.join("settings.json"),
+            json!({"statusLine": {"type": "command"}, "env": {"STALE_KEY": "x"}}).to_string(),
+        )
+        .unwrap();
+
+        let db = Arc::new(Database::memory().unwrap());
+        db.save_provider(
+            "claude",
+            &make_provider("a", "senseaudio", "deepseek-v4-pro"),
+        )
+        .unwrap();
+        db.save_provider("claude", &make_provider("b", "sensenova", "kimi-k3"))
+            .unwrap();
+        db.save_provider(
+            "claude",
+            &Provider::with_id(
+                "official".to_string(),
+                "Claude Official".to_string(),
+                json!({}),
