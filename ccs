#!/usr/bin/env bash
# ccs — Claude Code per-terminal provider switching
# (requires the patched CC Switch Router running with routing takeover enabled)
#
#   ccs                    Direct to the official Anthropic API (no local routing)
#   ccs <provider> [args…]  Route through the cc-switch local proxy (x-ccs-provider
#                          header), pinned to that provider; args pass to claude
#
#   --dangerously-skip-permissions is passed to claude by default (skips
#   permission prompts). Pass your own --permission-mode to override.
#
# Examples:
#   ccs                    # official
#   ccs kimi               # routed -> Kimi
#   ccs glm-router         # routed -> GLM standard endpoint (auto protocol conversion)
#   ccs kimi -c            # routed -> Kimi, continue last session
#
# Provider name = the name shown in the cc-switch UI (case-insensitive, partial match).
set -euo pipefail
# Prevent bash 3.2 from folding multibyte bytes into variable names under
# non-UTF-8 locales (fixes "NAME<0xE3>: unbound variable")
export LC_ALL=en_US.UTF-8

SETTINGS_DIR="${HOME}/.cc-switch/claude-settings"
mkdir -p "${SETTINGS_DIR}"

# 脚本版本（改动即更新，启动时打印用于确认终端里跑的是哪一版）
CCS_VERSION="2026.09.05-r6"
# 默认继承用户级 ~/.claude/settings.json（不传 --setting-sources ""）：
# /model 才能显示 Custom 模型条目（隔离模式只会渲染官方目录）。
# 映射显示优先取 ccs 生成的 per-provider 文件（本终端钉住的供应商），
# 缺失的键回落到用户级文件；claude 对 settings 文件热加载，
# cc-switch 改映射后 app 会自动重生成这些文件（补丁 v3.20.1-r3+）。
# CCS_ISOLATE=1 恢复隔离模式（不重定位配置目录，/model 无 Custom 条目实时性）。
ISOLATE="${CCS_ISOLATE:-0}"

json_escape() {
  printf "%s" "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# 与 cc-switch 路由接管写 ~/.claude/settings.json 的模式保持一致：
#   _MODEL      = 官方档位别名 id（客户端实际发送，代理按档位关键词实时映射）
#   _MODEL_NAME = 映射后的上游名（仅 /model 展示用，settings 文件热加载后即时刷新）
# 客户端永远只发官方别名，避免客户端解析出的上游名在代理侧被兜底换掉。
OFFICIAL_OPUS="claude-opus-4-8"
OFFICIAL_SONNET="claude-sonnet-4-6"
OFFICIAL_HAIKU="claude-haiku-4-5"
OFFICIAL_FABLE="claude-fable-5"

append_tier() {
  local tier="$1" official="$2" mapped="${3:-}"
  local key upper
  upper=$(printf "%s" "$tier" | tr 'a-z' 'A-Z')
  local name="${mapped:-$official}"
  printf ',\n    "ANTHROPIC_DEFAULT_%s_MODEL": "%s"' "$upper" "$(json_escape "$official")"
  printf ',\n    "ANTHROPIC_DEFAULT_%s_MODEL_NAME": "%s"' "$upper" "$(json_escape "$name")"
}

PROXY_BASE_URL="http://127.0.0.1:15721"
PROXY_AUTH_TOKEN="PROXY_MANAGED"

# 生成 per-provider 配置目录（CLAUDE_CONFIG_DIR 重定位）：
#   ~/.cc-switch/claude-home/<供应商>/settings.json 是 claude 的「用户级」settings——
#   与 ~/.claude/settings.json 同待遇、热加载，app 改映射后即时刷新 /model。
# 内容 = 用户真实 settings.json（保留 statusLine/permissions 等）+ env 整体覆盖
# （接管 BASE_URL/AUTH_TOKEN + x-ccs-provider 头 + 四档位别名/映射名）。
# 共享子项软链回主 ~/.claude（会话/历史/技能/插件跨供应商共用）。
safe_name() {
  local safe
  safe=$(printf "%s" "$1" | LC_ALL=C tr -cs 'A-Za-z0-9._-' '_' | sed 's/^_\+//;s/_\+$//')
  [ -n "$safe" ] || safe="provider"
  printf "%s" "$safe"
}

setup_provider_config_home() {
  local provider="$1" safe="$2"
  local home="${HOME}/.cc-switch/claude-home/${safe}"
  mkdir -p "$home"

  if [ -d "${HOME}/.claude" ]; then
    for item in skills plugins projects todos history.jsonl statsig session-env \
                downloads file-history cache shell-snapshots ide plans backups \
                mcp-needs-auth-cache.json config.json chrome; do
      if [ -e "${HOME}/.claude/$item" ] && [ ! -e "$home/$item" ]; then
        ln -s "${HOME}/.claude/$item" "$home/$item" 2>/dev/null
      fi
    done
  fi
  # onboarding 状态种子（避免新 home 首启走引导流程）
  if [ -f "${HOME}/.claude.json" ] && [ ! -e "$home/.claude.json" ]; then
    cp "${HOME}/.claude.json" "$home/.claude.json" 2>/dev/null
  fi

  local tmp="${home}/settings.json.tmp.$$"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "${HOME}" "$provider" \
      "$OFFICIAL_OPUS" "$OFFICIAL_SONNET" "$OFFICIAL_HAIKU" "$OFFICIAL_FABLE" \
      "${PROVIDER_DEFAULT_OPUS_MODEL:-}" "${PROVIDER_DEFAULT_SONNET_MODEL:-}" \
      "${PROVIDER_DEFAULT_HAIKU_MODEL:-}" "${PROVIDER_DEFAULT_FABLE_MODEL:-}" \
      > "$tmp" <<'PY'
import json, os, sys
home, provider = sys.argv[1], sys.argv[2]
tiers = ("opus", "sonnet", "haiku", "fable")
officials = tiers
mapped = dict(zip(tiers, sys.argv[7:11]))
officials = dict(zip(tiers, sys.argv[3:7]))
base = {}
base_path = os.path.join(home, ".claude", "settings.json")
if os.path.isfile(base_path):
    try:
        base = json.load(open(base_path))
    except Exception:
        base = {}
if not isinstance(base, dict):
    base = {}
env = {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:15721",
    "ANTHROPIC_AUTH_TOKEN": "PROXY_MANAGED",
    "ANTHROPIC_CUSTOM_HEADERS": f"x-ccs-provider: {provider}",
}
for tier in tiers:
    key = "ANTHROPIC_DEFAULT_" + tier.upper() + "_MODEL"
    env[key] = officials[tier]
    env[key + "_NAME"] = mapped.get(tier) or officials[tier]
base["env"] = env
sys.stdout.write(json.dumps(base, indent=2, ensure_ascii=False) + "\n")
PY
  else
    # 无 python3：退化为纯 provider env（丢失用户级 statusLine 等非 env 设置）
    {
      printf '{\n  "env": {\n'
      printf '    "ANTHROPIC_BASE_URL": "%s",\n' "$PROXY_BASE_URL"
      printf '    "ANTHROPIC_AUTH_TOKEN": "%s",\n' "$PROXY_AUTH_TOKEN"
      printf '    "ANTHROPIC_CUSTOM_HEADERS": "x-ccs-provider: %s"' "$(json_escape "$provider")"
      append_tier opus   "$OFFICIAL_OPUS"   "${PROVIDER_DEFAULT_OPUS_MODEL:-}"
      append_tier sonnet "$OFFICIAL_SONNET" "${PROVIDER_DEFAULT_SONNET_MODEL:-}"
      append_tier haiku  "$OFFICIAL_HAIKU"  "${PROVIDER_DEFAULT_HAIKU_MODEL:-}"
      append_tier fable  "$OFFICIAL_FABLE"  "${PROVIDER_DEFAULT_FABLE_MODEL:-}"
      printf '\n  }\n}\n'
    } > "$tmp"
  fi
  mv "$tmp" "$home/settings.json"
  printf "%s" "$home"
}

make_official_settings_file() {
  local file="${SETTINGS_DIR}/official.json"
  local tmp="${file}.tmp.$$"

  cat > "$tmp" <<'EOF'
{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "ANTHROPIC_AUTH_TOKEN": ""
  }
}
EOF
  mv "$tmp" "$file"
  printf "%s" "$file"
}

# 默认给 claude 加 --dangerously-skip-permissions（跳过权限确认）。
# 用户参数里显式带了权限相关 flag 时不重复添加，避免 claude CLI 参数冲突。
wants_skip_permissions() {
  for arg in "$@"; do
    case "$arg" in
      --dangerously-skip-permissions|--permission-mode|--permission-mode=*)
        return 1 ;;
    esac
  done
  return 0
}

case "${1:-}" in
  "")
    OFFICIAL_SETTINGS_FILE=$(make_official_settings_file)
    if wants_skip_permissions; then
      exec claude --dangerously-skip-permissions --setting-sources "" --settings "${OFFICIAL_SETTINGS_FILE}"
    else
      exec claude --setting-sources "" --settings "${OFFICIAL_SETTINGS_FILE}"
    fi
    ;;
  official|anthropic|claude)
    shift
    OFFICIAL_SETTINGS_FILE=$(make_official_settings_file)
    if wants_skip_permissions "$@"; then
      exec claude --dangerously-skip-permissions --setting-sources "" --settings "${OFFICIAL_SETTINGS_FILE}" "$@"
    else
      exec claude --setting-sources "" --settings "${OFFICIAL_SETTINGS_FILE}" "$@"
    fi
    ;;
  -h|--help|help)
    grep '^# ' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

NAME="$1"; shift
case "$NAME" in
  *'"'|*'\'*)
    echo "ccs: provider name contains illegal characters (quotes/backslash)" >&2
    exit 1 ;;
esac

# Pre-check local routing port
if ! nc -z 127.0.0.1 15721 2>/dev/null; then
  echo "ccs: local routing (127.0.0.1:15721) is not running -- start CC Switch Router and enable routing takeover" >&2
  exit 1
fi

# Resolve the canonical provider name from cc-switch.
# Matching rules: exact (case-insensitive) wins; otherwise the input must match
# EXACTLY ONE provider by substring -- multiple hits are an error, since we
# cannot know which one the user meant. The patched proxy matches the
# x-ccs-provider header by EXACT name, so the full name is required.
# 'Claude Official' is excluded: it does not support routing (use bare `ccs`).
DB_CHECK_OK=0
if command -v sqlite3 >/dev/null 2>&1 && [ -f "$HOME/.cc-switch/cc-switch.db" ]; then
  DB_CHECK_OK=1
  SAFE=${NAME//\'/}
  SAFE=${SAFE//\"/}
  FULL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT name FROM providers WHERE app_type='claude' AND name = '$SAFE' COLLATE NOCASE AND name <> 'Claude Official' LIMIT 1" 2>/dev/null || true)
  if [ -z "$FULL_NAME" ]; then
    CAND_COUNT=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
      "SELECT COUNT(*) FROM providers WHERE app_type='claude' AND name LIKE '%'||'$SAFE'||'%' AND name <> 'Claude Official'" 2>/dev/null || echo 0)
    if [ "${CAND_COUNT:-0}" = "0" ]; then
      echo "ccs: no Claude provider matching '${NAME}' in cc-switch (name must match the cc-switch UI)" >&2
      exit 1
    fi
    if [ "${CAND_COUNT:-0}" -gt 1 ]; then
      echo "ccs: '${NAME}' matches multiple providers -- be specific:" >&2
      sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
        "SELECT '  - '||name FROM providers WHERE app_type='claude' AND name LIKE '%'||'$SAFE'||'%' AND name <> 'Claude Official'" >&2 2>/dev/null
      exit 1
    fi
    FULL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
      "SELECT name FROM providers WHERE app_type='claude' AND name LIKE '%'||'$SAFE'||'%' AND name <> 'Claude Official' LIMIT 1" 2>/dev/null || true)
  fi
fi
if [ "$DB_CHECK_OK" = "1" ] && [ -z "$FULL_NAME" ]; then
  echo "ccs: provider '${NAME}' resolved to nothing" >&2
  exit 1
fi

if [ "$DB_CHECK_OK" = "1" ]; then
  # 只取四个档位的映射值（_MODEL_NAME 由 ccs 生成，不读供应商的 _NAME/ANTHROPIC_MODEL）
  for TIER in OPUS SONNET HAIKU FABLE; do
    VAR="PROVIDER_DEFAULT_${TIER}_MODEL"
    VAL=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
      "SELECT json_extract(settings_config,'\$.env.ANTHROPIC_DEFAULT_${TIER}_MODEL') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
    eval "$VAR=\$VAL"
  done
fi

MODE_TAG=""
[ "$ISOLATE" = "1" ] && MODE_TAG=" (isolated)" || true
echo "ccs: v${CCS_VERSION} provider \"${FULL_NAME}\"${MODE_TAG}" >&2
sleep 1

SAFE_NAME=$(safe_name "${FULL_NAME}")
CONFIG_HOME=$(setup_provider_config_home "${FULL_NAME}" "${SAFE_NAME}")
# 配置目录内的 settings.json 由 app 在供应商配置变化时自动重生成，
# claude 热加载后 /model 实时反映最新映射（无需重启）
echo "ccs: config home ${CONFIG_HOME}" >&2

# Route through the local proxy: inject x-ccs-provider header (canonical name)
# bash 3.2 + set -u 下空数组展开必须加 ${arr[@]+...} 保护（见 CLAUDE.md 已知 bug #2）
if [ "$ISOLATE" = "1" ]; then
  # 隔离模式：不重定位配置目录，退回独立 settings 文件（/model 无实时性）
  mkdir -p "${SETTINGS_DIR}"
  SETTINGS_FILE="${SETTINGS_DIR}/${SAFE_NAME}.json"
  cp "${CONFIG_HOME}/settings.json" "${SETTINGS_FILE}"
  if wants_skip_permissions "$@"; then
    exec claude --dangerously-skip-permissions --setting-sources "" --settings "${SETTINGS_FILE}" "$@"
  else
    exec claude --setting-sources "" --settings "${SETTINGS_FILE}" "$@"
  fi
else
  export CLAUDE_CONFIG_DIR="$CONFIG_HOME"
  if wants_skip_permissions "$@"; then
    exec claude --dangerously-skip-permissions "$@"
  else
    exec claude "$@"
  fi
fi
