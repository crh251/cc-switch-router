#!/usr/bin/env bash
# ccs — Claude Code per-terminal provider switching
# (requires the patched CC Switch Router running with routing takeover enabled)
#
#   ccs                    Direct to the official Anthropic API (no local routing)
#   ccs <provider> [args…]  Route through the cc-switch local proxy (x-ccs-provider
#                          header), pinned to that provider; args pass to claude
#
# Examples:
#   ccs                    # official
#   ccs kimi               # routed -> Kimi
#   ccs glm-router         # routed -> GLM standard endpoint (auto protocol conversion)
#   ccs kimi -c            # routed -> Kimi, continue last session
#
# Provider name = the name shown in the cc-switch UI (case-insensitive, partial match).
set -euo pipefail
# Prevent bash 3.2 from folding multibyte bytes into variable names under
# non-UTF-8 locales (fixes "NAME<0xE3>: unbound variable")
export LC_ALL=en_US.UTF-8

case "${1:-}" in
  "")
    # Official API direct: override base URL and clear token (claude.ai login)
    exec claude --settings '{"env":{"ANTHROPIC_BASE_URL":"https://api.anthropic.com","ANTHROPIC_AUTH_TOKEN":""}}'
    ;;
  -h|--help|help)
    grep '^# ' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

NAME="$1"; shift
case "$NAME" in
  *'"'|*'\'*)
    echo "ccs: provider name contains illegal characters (quotes/backslash)" >&2
    exit 1 ;;
esac

# Pre-check local routing port
if ! nc -z 127.0.0.1 15721 2>/dev/null; then
  echo "ccs: local routing (127.0.0.1:15721) is not running -- start CC Switch Router and enable routing takeover" >&2
  exit 1
fi

# Resolve the canonical provider name from cc-switch (case-insensitive partial
# match; exact match wins; shortest name wins on multiple hits). The patched
# proxy matches the x-ccs-provider header by EXACT name, so the partial input
# must be expanded to the full provider name first.
FULL_NAME=""
if command -v sqlite3 >/dev/null 2>&1 && [ -f "$HOME/.cc-switch/cc-switch.db" ]; then
  SAFE=${NAME//\'/}
  SAFE=${SAFE//\"/}
  FULL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT name FROM providers WHERE app_type='claude' AND name LIKE '%'||'$SAFE'||'%' ORDER BY (name = '$SAFE') DESC, (name LIKE '$SAFE'||'%') DESC, length(name) ASC LIMIT 1" 2>/dev/null || true)
fi
if [ -z "$FULL_NAME" ]; then
  echo "ccs: no Claude provider matching '${NAME}' in cc-switch (name must match the cc-switch UI)" >&2
  exit 1
fi

echo "ccs: provider \"${FULL_NAME}\" -> launching claude..." >&2
sleep 1

# Route through the local proxy: inject x-ccs-provider header (canonical name)
exec claude --settings "{\"env\":{\"ANTHROPIC_CUSTOM_HEADERS\":\"x-ccs-provider: ${FULL_NAME}\"}}" "$@"
