#!/usr/bin/env bash
# ccs — Claude Code per-terminal provider switching
# (requires the patched CC Switch Router running with routing takeover enabled)
#
#   ccs                    Direct to the official Anthropic API (no local routing)
#   ccs <provider> [args…]  Route through the cc-switch local proxy (x-ccs-provider
#                          header), pinned to that provider; args pass to claude
#
# Examples:
#   ccs                    # official
#   ccs kimi               # routed -> Kimi
#   ccs glm-router         # routed -> GLM standard endpoint (auto protocol conversion)
#   ccs kimi -c            # routed -> Kimi, continue last session
#
# Provider name = the name shown in the cc-switch UI (case-insensitive, partial match).
set -euo pipefail
# Prevent bash 3.2 from folding multibyte bytes into variable names under
# non-UTF-8 locales (fixes "NAME<0xE3>: unbound variable")
export LC_ALL=en_US.UTF-8

SETTINGS_DIR="${HOME}/.cc-switch/claude-settings"
mkdir -p "${SETTINGS_DIR}"

json_escape() {
  printf "%s" "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

append_env_if_set() {
  local key="$1"
  local value="$2"
  if [ -n "$value" ]; then
    printf ',\n    "%s": "%s"' "$key" "$(json_escape "$value")"
  fi
}

make_settings_file() {
  local provider="$1"
  local safe
  safe=$(printf "%s" "$provider" | LC_ALL=C tr -cs 'A-Za-z0-9._-' '_' | sed 's/^_\+//;s/_\+$//')
  [ -n "$safe" ] || safe="provider"
  local file="${SETTINGS_DIR}/${safe}.json"
  local tmp="${file}.tmp.$$"

  {
    printf '{\n'
    printf '  "env": {\n'
    printf '    "ANTHROPIC_CUSTOM_HEADERS": "x-ccs-provider: %s"' "$(json_escape "$provider")"

    append_env_if_set "ANTHROPIC_MODEL" "${PROVIDER_MODEL:-}"
    append_env_if_set "ANTHROPIC_DEFAULT_MODEL" "${PROVIDER_DEFAULT_MODEL:-}"
    append_env_if_set "ANTHROPIC_DEFAULT_MODEL_NAME" "${PROVIDER_DEFAULT_MODEL_NAME:-}"
    append_env_if_set "ANTHROPIC_DEFAULT_OPUS_MODEL" "${PROVIDER_DEFAULT_OPUS_MODEL:-}"
    append_env_if_set "ANTHROPIC_DEFAULT_FABLE_MODEL" "${PROVIDER_DEFAULT_FABLE_MODEL:-}"
    append_env_if_set "ANTHROPIC_DEFAULT_SONNET_MODEL" "${PROVIDER_DEFAULT_SONNET_MODEL:-}"
    append_env_if_set "ANTHROPIC_DEFAULT_HAIKU_MODEL" "${PROVIDER_DEFAULT_HAIKU_MODEL:-}"
    append_env_if_set "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME" "${PROVIDER_DEFAULT_OPUS_MODEL_NAME:-}"
    append_env_if_set "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME" "${PROVIDER_DEFAULT_FABLE_MODEL_NAME:-}"
    append_env_if_set "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME" "${PROVIDER_DEFAULT_SONNET_MODEL_NAME:-}"
    append_env_if_set "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME" "${PROVIDER_DEFAULT_HAIKU_MODEL_NAME:-}"
    append_env_if_set "ANTHROPIC_SMALL_FAST_MODEL" "${PROVIDER_SMALL_FAST_MODEL:-}"

    printf '\n  }\n'
    printf '}\n'
  } > "$tmp"

  mv "$tmp" "$file"
  printf "%s" "$file"
}

make_official_settings_file() {
  local file="${SETTINGS_DIR}/official.json"
  local tmp="${file}.tmp.$$"

  cat > "$tmp" <<'EOF'
{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "ANTHROPIC_AUTH_TOKEN": ""
  }
}
EOF
  mv "$tmp" "$file"
  printf "%s" "$file"
}

case "${1:-}" in
  "")
    OFFICIAL_SETTINGS_FILE=$(make_official_settings_file)
    exec claude --setting-sources "" --settings "${OFFICIAL_SETTINGS_FILE}"
    ;;
  official|anthropic|claude)
    shift
    OFFICIAL_SETTINGS_FILE=$(make_official_settings_file)
    exec claude --setting-sources "" --settings "${OFFICIAL_SETTINGS_FILE}" "$@"
    ;;
  -h|--help|help)
    grep '^# ' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

NAME="$1"; shift
case "$NAME" in
  *'"'|*'\'*)
    echo "ccs: provider name contains illegal characters (quotes/backslash)" >&2
    exit 1 ;;
esac

# Pre-check local routing port
if ! nc -z 127.0.0.1 15721 2>/dev/null; then
  echo "ccs: local routing (127.0.0.1:15721) is not running -- start CC Switch Router and enable routing takeover" >&2
  exit 1
fi

# Resolve the canonical provider name from cc-switch.
# Matching rules: exact (case-insensitive) wins; otherwise the input must match
# EXACTLY ONE provider by substring -- multiple hits are an error, since we
# cannot know which one the user meant. The patched proxy matches the
# x-ccs-provider header by EXACT name, so the full name is required.
# 'Claude Official' is excluded: it does not support routing (use bare `ccs`).
DB_CHECK_OK=0
if command -v sqlite3 >/dev/null 2>&1 && [ -f "$HOME/.cc-switch/cc-switch.db" ]; then
  DB_CHECK_OK=1
  SAFE=${NAME//\'/}
  SAFE=${SAFE//\"/}
  FULL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT name FROM providers WHERE app_type='claude' AND name = '$SAFE' COLLATE NOCASE AND name <> 'Claude Official' LIMIT 1" 2>/dev/null || true)
  if [ -z "$FULL_NAME" ]; then
    CAND_COUNT=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
      "SELECT COUNT(*) FROM providers WHERE app_type='claude' AND name LIKE '%'||'$SAFE'||'%' AND name <> 'Claude Official'" 2>/dev/null || echo 0)
    if [ "${CAND_COUNT:-0}" = "0" ]; then
      echo "ccs: no Claude provider matching '${NAME}' in cc-switch (name must match the cc-switch UI)" >&2
      exit 1
    fi
    if [ "${CAND_COUNT:-0}" -gt 1 ]; then
      echo "ccs: '${NAME}' matches multiple providers -- be specific:" >&2
      sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
        "SELECT '  - '||name FROM providers WHERE app_type='claude' AND name LIKE '%'||'$SAFE'||'%' AND name <> 'Claude Official'" >&2 2>/dev/null
      exit 1
    fi
    FULL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
      "SELECT name FROM providers WHERE app_type='claude' AND name LIKE '%'||'$SAFE'||'%' AND name <> 'Claude Official' LIMIT 1" 2>/dev/null || true)
  fi
fi
if [ "$DB_CHECK_OK" = "1" ] && [ -z "$FULL_NAME" ]; then
  echo "ccs: provider '${NAME}' resolved to nothing" >&2
  exit 1
fi

if [ "$DB_CHECK_OK" = "1" ]; then
  PROVIDER_MODEL=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_MODEL') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_DEFAULT_MODEL=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_DEFAULT_MODEL') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_DEFAULT_MODEL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_DEFAULT_MODEL_NAME') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_DEFAULT_OPUS_MODEL=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_DEFAULT_OPUS_MODEL') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_DEFAULT_FABLE_MODEL=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_DEFAULT_FABLE_MODEL') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_DEFAULT_SONNET_MODEL=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_DEFAULT_SONNET_MODEL') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_DEFAULT_HAIKU_MODEL=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_DEFAULT_HAIKU_MODEL') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_DEFAULT_OPUS_MODEL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_DEFAULT_OPUS_MODEL_NAME') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_DEFAULT_FABLE_MODEL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_DEFAULT_FABLE_MODEL_NAME') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_DEFAULT_SONNET_MODEL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_DEFAULT_SONNET_MODEL_NAME') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_DEFAULT_HAIKU_MODEL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
  PROVIDER_SMALL_FAST_MODEL=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT json_extract(settings_config,'$.env.ANTHROPIC_SMALL_FAST_MODEL') FROM providers WHERE app_type='claude' AND name = '$FULL_NAME' COLLATE NOCASE LIMIT 1" 2>/dev/null || true)
fi

echo "ccs: provider \"${FULL_NAME}\"" >&2
sleep 1

SETTINGS_FILE=$(make_settings_file "${FULL_NAME}")

# Route through the local proxy: inject x-ccs-provider header (canonical name)
exec claude --setting-sources "" --settings "${SETTINGS_FILE}" "$@"
