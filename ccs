#!/usr/bin/env bash
# ccs — Claude Code per-terminal provider switching
# (requires the patched CC Switch Router running with routing takeover enabled)
#
#   ccs                    Direct to the official Anthropic API (no local routing;
#                          same config-home mechanism, official settings.json)
#   ccs <provider> [args…]  Route through the cc-switch local proxy (x-ccs-provider
#                          header), pinned to that provider; args pass to claude
#
#   --dangerously-skip-permissions is passed to claude by default (skips
#   permission prompts). Pass your own --permission-mode to override.
#
# Examples:
#   ccs                    # official direct (no local routing, plugins loaded)
#   ccs kimi               # routed -> Kimi
#   ccs glm-router         # routed -> GLM standard endpoint (auto protocol conversion)
#   ccs kimi -c            # routed -> Kimi, continue last session
#
# Provider name = the name shown in the cc-switch UI (case-insensitive; prefix match).
set -euo pipefail
# Prevent bash 3.2 from folding multibyte bytes into variable names under
# non-UTF-8 locales (fixes "NAME<0xE3>: unbound variable")
export LC_ALL=en_US.UTF-8

# 脚本版本：写死为最后一次逻辑修改的时间戳（东八区，形如 20260906_100050）；
# ccs 逻辑有更新时必须同步改成当时的修改时间（app 关于窗口显示的就是这个版本）
CCS_VERSION="20260906_161712"

# 官方会话状态栏脚本：物化到 ~/.cc-switch/ccs-statusline.py，官方 settings.json
# 的 statusLine 指向它。公司托管策略把官方会话插件做成白名单（仅 guardrails，
# 见 CLAUDE.md 已知 bug 19），claude-hud 加载不了，statusLine 是官方会话的
# token/context 显示替代。每次启动覆盖写入（与 ccs 版本保持同步）。
install_statusline() {
  local dest="${HOME}/.cc-switch/ccs-statusline.py"
  mkdir -p "${HOME}/.cc-switch"
  cat > "${dest}.tmp.$$" <<'CSSL'
#!/usr/bin/env python3
# ccs-statusline -- one-line status for Claude Code statusLine (installed by ccs).
# Shows: dir/branch/model, last-turn output tokens, session total tokens
# (in + out + cache write + cache read, per-message-id dedup like claude-hud),
# native context percentage (used_percentage, fallback tokens/window), session cost.
import json, os, subprocess, sys

CACHE = os.path.expanduser("~/.cc-switch/.ccs-statusline-cache.json")
DEFAULT_WINDOW = 200000
FIELDS = ("in", "cc", "cr", "out")

def ans(code):
    return "\033[%dm" % code

def fmt(n):
    n = int(n)
    if n < 1000:
        return str(n)
    if n < 1000000:
        s = ("%.1f" % (n / 1000.0)).rstrip("0").rstrip(".")
        return s + "k"
    s = ("%.1f" % (n / 1000000.0)).rstrip("0").rstrip(".")
    return s + "M"

def load_state():
    try:
        with open(CACHE) as f:
            d = json.load(f)
        return d if isinstance(d, dict) and isinstance(d.get("e"), dict) else {"e": {}}
    except Exception:
        return {"e": {}}

def save_state(state):
    try:
        entries = state["e"]
        if len(entries) > 8:
            for k in sorted(entries, key=lambda k: entries[k].get("t", 0))[:-8]:
                del entries[k]
        tmp = CACHE + ".tmp.%d" % os.getpid()
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, CACHE)
    except Exception:
        pass

def process_line(ln, seen, totals):
    # returns (message_id, usage_tuple) for assistant entries, else None
    try:
        d = json.loads(ln)
    except Exception:
        return None
    if not isinstance(d, dict) or d.get("type") != "assistant" or d.get("isSidechain"):
        return None
    msg = d.get("message") or {}
    u = msg.get("usage")
    if not isinstance(u, dict):
        return None
    mid = msg.get("id")
    if not mid:
        return None
    cur = (int(u.get("input_tokens") or 0),
           int(u.get("cache_creation_input_tokens") or 0),
           int(u.get("cache_read_input_tokens") or 0),
           int(u.get("output_tokens") or 0))
    prior = seen.get(mid)
    if prior is None:
        for i in range(4):
            totals[i] += cur[i]
    else:
        for i in range(4):
            delta = cur[i] - prior[i]
            if delta > 0:
                totals[i] += delta
        cur = tuple(max(prior[i], cur[i]) for i in range(4))
    seen[mid] = cur
    return (mid, cur)

def read_stats(tp):
    # incremental transcript parse; per-path state carries byte offset + running
    # totals + the most recent message usage (streaming lines repeat the same
    # message id with growing counts, so dedup must carry across renders)
    state = load_state()
    entries = state["e"]
    ent = entries.get(tp) or {}
    try:
        fsize = os.path.getsize(tp)
    except OSError:
        return None
    offset = ent.get("offset", 0)
    if not isinstance(offset, int) or offset < 0 or offset > fsize:
        ent, offset = {}, 0
    totals = list(ent.get("totals") or [0, 0, 0, 0])
    if not isinstance(totals, list) or len(totals) != 4:
        totals = [0, 0, 0, 0]
    seen = {}
    carried_id = ent.get("id")
    carried_u = ent.get("u")
    if isinstance(carried_id, str) and isinstance(carried_u, list) and len(carried_u) == 4:
        seen[carried_id] = tuple(carried_u)
    last_mid, last_u4 = carried_id, carried_u
    try:
        with open(tp, "rb") as f:
            if offset:
                f.seek(offset)
            raw = f.read()
    except OSError:
        return None
    if not raw.endswith(b"\n"):
        cut = raw.rfind(b"\n")
        if cut == -1:
            new_offset = offset
            raw = b""
        else:
            new_offset = offset + cut + 1
            raw = raw[:cut + 1]
    else:
        new_offset = offset + len(raw)
    if raw:
        for ln in raw.decode("utf-8", "replace").splitlines():
            r = process_line(ln, seen, totals)
            if r:
                last_mid, last_u4 = r
    out_ent = {
        "offset": new_offset,
        "totals": totals,
        "id": last_mid,
        "u": list(last_u4) if last_u4 else None,
        "last_out": (last_u4[3] if last_u4 else (ent.get("last_out") or 0)),
        "t": ent.get("t", 0),
    }
    entries[tp] = out_ent
    save_state(state)
    return out_ent

def main():
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    if not isinstance(data, dict):
        data = {}

    model = (data.get("model") or {}).get("display_name") or "claude"
    ws = data.get("workspace") or {}
    d = ws.get("current_dir") or data.get("cwd") or os.getcwd()

    out_line = "%s%s%s" % (ans(36), os.path.basename(d) or d, ans(0))
    branch = ""
    try:
        r = subprocess.run(["git", "-C", d, "branch", "--show-current"],
                           capture_output=True, timeout=2)
        if r.returncode == 0:
            branch = r.stdout.decode("utf-8", "replace").strip()
    except Exception:
        branch = ""
    if branch:
        out_line += " %s⎇ %s%s" % (ans(35), branch, ans(0))
    out_line += " %s·%s %s%s%s" % (ans(2), ans(0), ans(33), model, ans(0))

    tp = data.get("transcript_path")
    if isinstance(tp, str) and tp and os.path.isfile(tp):
        st = read_stats(tp)
        if st:
            t = st["totals"]
            out_line += " %s·%s last %s · total %s" % (
                ans(2), ans(0), fmt(st.get("last_out") or 0),
                fmt(t[0] + t[1] + t[2] + t[3]))

    cw = data.get("context_window") or {}
    cu = cw.get("current_usage") or {}
    ctx_tok = 0
    try:
        ctx_tok = (int(cu.get("input_tokens") or 0)
                   + int(cu.get("cache_creation_input_tokens") or 0)
                   + int(cu.get("cache_read_input_tokens") or 0))
    except Exception:
        ctx_tok = 0
    size = cw.get("context_window_size")
    size = size if isinstance(size, int) and size > 0 else DEFAULT_WINDOW
    pct = cw.get("used_percentage")
    if not (isinstance(pct, (int, float)) and pct == pct and pct > 0):
        pct = (ctx_tok * 100.0 / size) if ctx_tok else 0.0
    pct = max(0, min(100, int(round(pct))))
    color = 32 if pct < 60 else (33 if pct < 85 else 31)
    out_line += " %s·%s %sctx %d%%%s (%s/%s)" % (
        ans(2), ans(0), ans(color), pct, ans(0), fmt(ctx_tok), fmt(size))

    cost = (data.get("cost") or {}).get("total_cost_usd")
    if isinstance(cost, (int, float)) and cost == cost and cost >= 0:
        out_line += " %s·%s $%.2f" % (ans(2), ans(0), cost)

    print(out_line)

try:
    main()
except Exception:
    print("ccs-statusline")
CSSL
  mv "${dest}.tmp.$$" "${dest}"
}
install_statusline


# 准备 per-provider 配置目录（CLAUDE_CONFIG_DIR 重定位）。settings.json 由
# CC Switch Router 写入与维护（app 启动同步 + 供应商增删改重生成，含插件启用
# 状态并集），ccs 不写配置文件，只做目录脚手架：共享子项软链回主 ~/.claude
# （会话/历史/技能/插件跨供应商共用）+ onboarding 种子。
safe_name() {
  local safe
  safe=$(printf "%s" "$1" | LC_ALL=C tr -cs 'A-Za-z0-9._-' '_' | sed 's/^_\+//;s/_\+$//')
  [ -n "$safe" ] || safe="provider"
  printf "%s" "$safe"
}

setup_provider_config_home() {
  local provider="$1" safe="$2"
  local home="${HOME}/.cc-switch/claude-home/${safe}"
  mkdir -p "$home"

  if [ -d "${HOME}/.claude" ]; then
    for item in skills plugins projects todos history.jsonl statsig session-env \
                downloads file-history cache shell-snapshots ide plans backups \
                mcp-needs-auth-cache.json config.json chrome; do
      if [ -e "${HOME}/.claude/$item" ] && [ ! -e "$home/$item" ]; then
        ln -s "${HOME}/.claude/$item" "$home/$item" 2>/dev/null
      fi
    done
  fi
  # onboarding 状态种子（避免新 home 首启走引导流程）
  if [ -f "${HOME}/.claude.json" ] && [ ! -e "$home/.claude.json" ]; then
    cp "${HOME}/.claude.json" "$home/.claude.json" 2>/dev/null
  fi

  printf "%s" "$home"
}

# 官方直连的 config home settings：env 块带官方地址（BASE_URL/AUTH_TOKEN 空串
# = 走 claude.ai OAuth），插件启用状态取全局 ~/.claude/settings.json ∪ 既有 home
# 文件的并集（true 优先——/plugin 的开关写在 home 自己的 settings.json 里）。
# 必须走 CLAUDE_CONFIG_DIR 标准源：--setting-sources "" + --settings 非标准源下
# 插件解析失败（实测 4/5 failed to load），标准源与路由供应商机制完全一致。
# 注意：该 home 不对应 cc-switch 供应商，app 启动的遗留目录清理会删掉它，
# ccs 每次启动重建（脚手架幂等）。
OFFICIAL_HOME_NAME="claude-official"

make_official_settings_file() {
  local home="$1"
  local file="${home}/settings.json"
  local tmp="${file}.tmp.$$"

  if command -v python3 >/dev/null 2>&1; then
    python3 - "$home" > "$tmp" <<'PY'
import json, glob, os, sys
home = sys.argv[1]
out = {"env": {
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    # 不得写 ANTHROPIC_AUTH_TOKEN（连空串占位都不行）：托管策略 org pin 按「键存在」
    # 判定非 OAuth 凭据，交互式启动直接报错（CLAUDE.md 已知 bug 18）。2.1.263 实测
    # config-dir 会话不合并全局 settings，旧方案「空串压制全局接管 env」已无必要。
    # 官方 /model 回归原生：置空四组档位键（旧版二进制会合并全局文件，防御性压掉
    # 被接管写入的 ANTHROPIC_DEFAULT_*_MODEL(_NAME)）
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "",
}}
plugins, markets = {}, {}
sources = [os.path.expanduser("~/.claude/settings.json"),
           os.path.join(home, "settings.json")]
sources += sorted(glob.glob(os.path.join(
    os.path.expanduser("~"), ".cc-switch", "claude-home", "*", "settings.json")))
for path in sources:
    try:
        user = json.load(open(path))
    except Exception:
        continue
    if not isinstance(user, dict):
        continue
    for k, v in (user.get("enabledPlugins") or {}).items():
        plugins[k] = bool(v) or plugins.get(k, False)
    for k, v in (user.get("extraKnownMarketplaces") or {}).items():
        markets.setdefault(k, v)
if plugins:
    out["enabledPlugins"] = plugins
if markets:
    out["extraKnownMarketplaces"] = markets
# 官方会话状态栏（hud 插件被公司插件白名单挡掉，见已知 bug 19）；
# 脚本由 ccs 每次启动物化到 ~/.cc-switch/ccs-statusline.py
out["statusLine"] = {
    "type": "command",
    "command": "python3 ${HOME}/.cc-switch/ccs-statusline.py",
    "padding": 0,
}
print(json.dumps(out, indent=2, ensure_ascii=False))
PY
  else
    cat > "$tmp" <<'EOF'
{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com"
  }
}
EOF
  fi
  mv "$tmp" "$file"
}

# 默认给 claude 加 --dangerously-skip-permissions（跳过权限确认）。
# 用户参数里显式带了权限相关 flag 时不重复添加，避免 claude CLI 参数冲突。
wants_skip_permissions() {
  for arg in "$@"; do
    case "$arg" in
      --dangerously-skip-permissions|--permission-mode|--permission-mode=*)
        return 1 ;;
    esac
  done
  return 0
}

# 官方不走路由、不是 cc-switch 供应商：与路由供应商同一套 CLAUDE_CONFIG_DIR
# 机制，settings.json 内容为官方配置（见 make_official_settings_file）。
#   ccs / ccs claude / ccs official / ccs anthropic   官方直连
#   ccs -c / ccs --version   首参以 - 开头视为官方模式的 claude 参数
case "${1:-}" in
  -h|--help|help)
    grep '^# ' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

IS_OFFICIAL=0
case "${1:-}" in
  ""|claude|official|anthropic)
    IS_OFFICIAL=1
    [ $# -gt 0 ] && shift ;;
  -*)
    IS_OFFICIAL=1 ;;
esac
if [ "$IS_OFFICIAL" = "1" ]; then
  echo "ccs: ${CCS_VERSION} official direct (claude-official home)" >&2
  CONFIG_HOME=$(setup_provider_config_home "claude-official" "${OFFICIAL_HOME_NAME}")
  make_official_settings_file "${CONFIG_HOME}"
  export CLAUDE_CONFIG_DIR="$CONFIG_HOME"
  # org pin（托管策略）要求官方会话只有 OAuth 凭据：清掉 shell 可能带入的
  # ANTHROPIC_API_KEY/ANTHROPIC_AUTH_TOKEN，避免非 OAuth 凭据启动报错（已知 bug 18）
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
  # CLAUDE_CONFIG_DIR 下 claude 用带目录哈希后缀的独立 Keychain 键，官方 home
  # 没有独立登录记录 → 实时读主目录键注入 CLAUDE_CODE_OAUTH_TOKEN（token 由
  # 主目录会话自动刷新，不落盘；读不到时跳过，claude 会自己提示 /login）
  if command -v /usr/bin/security >/dev/null 2>&1; then
    OAUTH_TOKEN=$(/usr/bin/security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null \
      | python3 -c "import json,sys; print(json.load(sys.stdin).get('claudeAiOauth',{}).get('accessToken',''))" 2>/dev/null || true)
    if [ -n "${OAUTH_TOKEN}" ]; then
      export CLAUDE_CODE_OAUTH_TOKEN="${OAUTH_TOKEN}"
    fi
  fi
  # 只保留 user（config-dir）这一层设置源：在 ~ 等目录下 ~/.claude/settings.json
  # （全局接管文件，env 含 AUTH_TOKEN=PROXY_MANAGED）会被当作项目级 settings 加载，
  # org pin 凭据检查扫到即拒绝启动（已知 bug 18）；官方会话不需要项目/本地层的接管 env
  if wants_skip_permissions "$@"; then
    exec claude --dangerously-skip-permissions --setting-sources user "$@"
  else
    exec claude --setting-sources user "$@"
  fi
fi

NAME="$1"; shift
case "$NAME" in
  *'"'|*'\'*)
    echo "ccs: provider name contains illegal characters (quotes/backslash)" >&2
    exit 1 ;;
esac

# Pre-check local routing port
if ! nc -z 127.0.0.1 15721 2>/dev/null; then
  echo "ccs: local routing (127.0.0.1:15721) is not running -- start CC Switch Router and enable routing takeover" >&2
  exit 1
fi

# Resolve the canonical provider name from cc-switch.
# Matching rules: exact (case-insensitive) wins; otherwise the input must be a
# PREFIX of EXACTLY ONE provider -- multiple hits are an error, since we
# cannot know which one the user meant. Non-prefix substrings never match.
# The patched proxy matches the x-ccs-provider header by EXACT name, so the
# full canonical name is required. 'Claude Official' is excluded (bare `ccs`).
DB_CHECK_OK=0
if command -v sqlite3 >/dev/null 2>&1 && [ -f "$HOME/.cc-switch/cc-switch.db" ]; then
  DB_CHECK_OK=1
  SAFE=${NAME//\'/}
  SAFE=${SAFE//\"/}
  FULL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
    "SELECT name FROM providers WHERE app_type='claude' AND name = '$SAFE' COLLATE NOCASE AND name <> 'Claude Official' LIMIT 1" 2>/dev/null || true)
  if [ -z "$FULL_NAME" ]; then
    CAND_COUNT=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
      "SELECT COUNT(*) FROM providers WHERE app_type='claude' AND name LIKE '$SAFE'||'%' AND name <> 'Claude Official'" 2>/dev/null || echo 0)
    if [ "${CAND_COUNT:-0}" = "0" ]; then
      echo "ccs: no Claude provider matching '${NAME}' in cc-switch (name must match the cc-switch UI)" >&2
      exit 1
    fi
    if [ "${CAND_COUNT:-0}" -gt 1 ]; then
      echo "ccs: '${NAME}' matches multiple providers -- be specific:" >&2
      sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
        "SELECT '  - '||name FROM providers WHERE app_type='claude' AND name LIKE '$SAFE'||'%' AND name <> 'Claude Official'" >&2 2>/dev/null
      exit 1
    fi
    FULL_NAME=$(sqlite3 -readonly "$HOME/.cc-switch/cc-switch.db" \
      "SELECT name FROM providers WHERE app_type='claude' AND name LIKE '$SAFE'||'%' AND name <> 'Claude Official' LIMIT 1" 2>/dev/null || true)
  fi
fi
if [ "$DB_CHECK_OK" = "1" ] && [ -z "$FULL_NAME" ]; then
  echo "ccs: provider '${NAME}' resolved to nothing" >&2
  exit 1
fi


echo "ccs: ${CCS_VERSION} provider \"${FULL_NAME}\"" >&2
sleep 1

SAFE_NAME=$(safe_name "${FULL_NAME}")
CONFIG_HOME=$(setup_provider_config_home "${FULL_NAME}" "${SAFE_NAME}")
# settings.json 由 CC Switch Router 负责写入（启动同步 + 供应商增删改重生成），
# ccs 不写配置文件。缺失 = app 尚未同步（或目录被手删），拒绝启动以免产生
# 无 BASE_URL 的裸会话
if [ ! -f "${CONFIG_HOME}/settings.json" ]; then
  echo "ccs: missing settings.json in ${CONFIG_HOME}" >&2
  echo "ccs: restart CC Switch Router so it rewrites provider config files, then retry" >&2
  exit 1
fi
# claude 对 settings 热加载：app 改映射后 /model 实时反映最新映射（无需重启）
echo "ccs: config home ${CONFIG_HOME}" >&2

# Route through the local proxy: inject x-ccs-provider header (canonical name)
export CLAUDE_CONFIG_DIR="$CONFIG_HOME"
if wants_skip_permissions "$@"; then
  exec claude --dangerously-skip-permissions "$@"
else
  exec claude "$@"
fi
